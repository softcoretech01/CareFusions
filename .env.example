# Template for the per-environment files. Copy, fill in, never commit:
#
#   .env.dev    Developer  — UI 5180, API 8008, DB 3330
#   .env.test   Tester     — UI 5181, API 8009, DB 3331
#   .env.prod   Production — UI 5176, API 8005, DB 3320
#
# All three are gitignored. On the server Jenkins writes them from its
# Credentials store; nothing here should ever hold a real secret.

# ── Identity ──────────────────────────────────────────────────
# Selects which file docker-compose.yml loads (.env.${APP_ENV}), so it must
# match this file's own suffix: dev | test | prod
APP_ENV=dev

# Written by Jenkins at deploy time as vP.T.D — the production, tester and
# developer release counters. Never baked into an image: the same image is
# promoted between environments, only this value changes.
# Surfaced by GET /api/v1/version.
APP_VERSION=0.0.0-unversioned

# The commit the image was built from. This, not APP_VERSION, is the immutable
# identity of a build — it is what a bug report should quote.
APP_COMMIT=unknown

# ── Images ────────────────────────────────────────────────────
REGISTRY=localhost:5000
# The immutable sha-<commit> tag. Jenkins sets this; `latest` is a local
# convenience only and must not be used on a server lane.
IMAGE_TAG=latest

# ── Ports ─────────────────────────────────────────────────────
UI_PORT=5180
API_PORT=8008

# ── Database ──────────────────────────────────────────────────
# One connection serves all four schemas. DB_NAME must stay `admin`: ~52 master
# stored procedures are unqualified and resolve against the default schema.
# Cross-schema objects (registration.*, hospital.*, inventory.*) are always
# fully qualified and work regardless.
DB_HOST=100.86.181.18
DB_PORT=3330
DB_NAME=admin

# One user per environment — cf_dev / cf_test / cf_prod, each granted only on
# its own schemas. Do not use root.
DB_USER=cf_dev
DB_PASSWORD=

# MySQL runs on a UTC host, so without this NOW() returns UTC and a bill's
# timestamp depends on which machine served the request.
DB_TIME_ZONE=+05:30

# ── Auth ──────────────────────────────────────────────────────
# MUST differ per environment. A shared value makes a token minted in Developer
# valid in Production. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is created per process — tokens then die on restart
# and cannot validate across workers.
AUTH_SECRET=

AUTH_TOKEN_TTL_HOURS=12

# Master switch for endpoint protection. While false, EVERY endpoint is public.
# Turn it on one lane at a time, Developer first: the unattended scripts in
# Python/ call the API with no credentials and break the moment it flips.
REQUIRE_AUTH=false

# Rejects callers with no identity. Defaults to following REQUIRE_AUTH.
ENFORCE_RBAC=false

# ── CORS ──────────────────────────────────────────────────────
# The frontend reaches the API same-origin through nginx, so this is defence in
# depth rather than load-bearing. Comma-separated. Leaving it unset means "*",
# and the backend logs a warning at boot when it is.
#   dev http://100.86.181.18:5180 | test :5181 | prod :5176
ALLOWED_ORIGINS=http://100.86.181.18:5180
