# Copy to Python/.env and fill in. Python/.env is gitignored — never commit real
# credentials.

# ── Database ──────────────────────────────────────────────────
# One connection serves all schemas. DB_NAME must stay `admin`: the ~52 master
# stored procedures are unqualified and resolve against the default schema.
# Cross-schema objects (registration.*, hospital.*, inventory.*) are always
# fully qualified, so they work regardless.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=admin

# ── Auth ──────────────────────────────────────────────────────
# Signs the token returned by POST /api/v1/auth/login. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is created per process — tokens then die on restart
# and cannot validate across multiple workers.
AUTH_SECRET=

# How long a login stays valid, in hours.
AUTH_TOKEN_TTL_HOURS=12

# Master switch for endpoint protection. While false, EVERY endpoint is public.
# Ships false so existing callers (including the scripts in Python/) keep
# working; set true once every client sends the login token.
REQUIRE_AUTH=false
