# Copy to frontend/.env for local development. frontend/.env is gitignored.
#
# In a built image this value comes from the Dockerfile build arg, not from a
# file — see frontend/Dockerfile.

# Relative on purpose, and the same value in every environment.
#
# nginx in the frontend container proxies /api/v1 and /uploads to the backend
# (frontend/nginx.conf), so the API is same-origin. That is what allows ONE
# built image to serve Developer, Tester and Production, and a promotion to
# re-tag an image digest instead of rebuilding.
#
# Running `npm run dev` outside Docker? This still works: vite.config.ts proxies
# /api/v1 to VITE_DEV_API_PROXY (default http://localhost:8000).
VITE_API_URL=/api/v1

# Where the dev server forwards API calls. Only read by vite.config.ts during
# `npm run dev`; irrelevant to a built image.
#   bare npm run dev         -> http://localhost:8000
#   docker-compose.local.yml -> http://backend:8000 (set by compose)
VITE_DEV_API_PROXY=http://localhost:8000
